{
  "expo": {
    "name": "Life Dashboard",
    "slug": "lifeapp",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lifeapp.dashboard",
      "versionCode": 17,
      "permissions": [
        "WAKE_LOCK",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show local weather on your Home screen."
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Life Dashboard to use the microphone to dictate notes.",
          "speechRecognitionPermission": "Allow Life Dashboard to transcribe dictated notes.",
          "androidSpeechServicePackages": ["com.google.android.as"]
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "324aa5a8-5341-483b-910e-184c658fffce"
      }
    }
  }
}
