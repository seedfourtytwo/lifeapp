<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/row_root"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:minHeight="60dp"
  android:background="@drawable/life_widget_card"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="12dp"
  android:paddingEnd="8dp">

  <ImageView
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:importantForAccessibility="no"
    android:src="@drawable/life_widget_tile_todo" />
  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="8dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
      android:id="@+id/row_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="2"
      android:textColor="@color/life_widget_text"
      android:textSize="17sp" />

    <!-- The same title in the quiet colour, for a todo ticked today. -->
    <TextView
      android:id="@+id/row_name_settled"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="2"
      android:textColor="@color/life_widget_text_muted"
      android:textSize="17sp"
      android:visibility="gone" />

    <!-- When it is due. Two views, one per colour: overdue and today stand out. -->
    <TextView
      android:id="@+id/row_meta"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:textColor="@color/life_widget_text_muted"
      android:textSize="14sp"
      android:visibility="gone" />

    <TextView
      android:id="@+id/row_meta_alert"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:textColor="@color/life_widget_todo"
      android:textSize="14sp"
      android:visibility="gone" />
  </LinearLayout>
  <!-- Only the box is the tap target: a todo is ticked on purpose, not by brushing the row. -->
  <ImageView
    android:id="@+id/row_box"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:background="@drawable/life_widget_todo_open"
    android:scaleType="center" />
</LinearLayout>
