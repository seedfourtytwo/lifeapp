<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/life_widget_background"
  android:orientation="vertical"
  android:paddingStart="12dp"
  android:paddingTop="14dp"
  android:paddingEnd="12dp"
  android:paddingBottom="12dp">

  <LinearLayout
    android:id="@+id/widget_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="2dp">

    <TextView
      android:id="@+id/widget_date"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:fontFamily="serif"
      android:maxLines="1"
      android:textColor="@color/life_widget_text"
      android:textSize="28sp" />

    <!-- The day's tally: what is done, bright; out of how many, quiet. -->
    <TextView
      android:id="@+id/widget_progress"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:fontFamily="sans-serif-medium"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:textColor="@color/life_widget_text"
      android:textSize="18sp" />

    <TextView
      android:id="@+id/widget_progress_total"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:textColor="@color/life_widget_text_muted"
      android:textSize="18sp" />

    <!-- The one deliberate way into the app; from the lock screen it asks for the unlock. -->
    <ImageView
      android:id="@+id/widget_open"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_marginStart="4dp"
      android:contentDescription="@string/life_widget_open_app"
      android:scaleType="center"
      android:src="@drawable/life_widget_ic_open_muted" />
  </LinearLayout>

  <!-- The day as a row of segments, one per habit due; filled in from the provider. -->
  <LinearLayout
    android:id="@+id/widget_segments"
    android:layout_width="match_parent"
    android:layout_height="6dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="14dp"
    android:importantForAccessibility="no"
    android:orientation="horizontal" />

  <!--
    The habit being timed now. It looks like a list item but sits outside the
    list: a Chronometer ticks here and does not inside list items on the
    lock-screen page, and pinned it stays in reach while the list scrolls.
  -->
  <LinearLayout
    android:id="@+id/widget_now"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:paddingStart="6dp"
      android:paddingBottom="6dp"
      android:text="@string/life_widget_label_now"
      android:textColor="@color/life_widget_timer"
      android:textSize="13sp" />

    <LinearLayout
      android:id="@+id/widget_now_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="76dp"
      android:background="@drawable/life_widget_card_running"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="14dp"
      android:paddingTop="8dp"
      android:paddingEnd="8dp"
      android:paddingBottom="8dp">

      <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:src="@drawable/life_widget_tile_timer_running" />

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/widget_now_name"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:maxLines="1"
          android:textColor="@color/life_widget_text"
          android:textSize="17sp" />

        <!-- Today's time on this habit, ticking: what is logged plus this session. -->
        <Chronometer
          android:id="@+id/widget_now_clock"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
      android:fontFeatureSettings="tnum"
          android:maxLines="1"
          android:textColor="@color/life_widget_timer"
          android:textSize="18sp" />

        <ProgressBar
          android:id="@+id/widget_now_progress"
          style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="match_parent"
          android:layout_height="6dp"
          android:layout_marginTop="6dp"
          android:importantForAccessibility="no"
          android:progressDrawable="@drawable/life_widget_progress_timer" />
      </LinearLayout>

      <ImageView
        android:id="@+id/widget_now_toggle"
        style="@style/LifeWidgetIconButton" />

      <ImageView
        android:id="@+id/widget_now_stop"
        style="@style/LifeWidgetIconButton" />
    </LinearLayout>
  </LinearLayout>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <ListView
      android:id="@+id/widget_list"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:divider="@android:color/transparent"
      android:dividerHeight="8dp"
      android:scrollbars="none" />

    <TextView
      android:id="@+id/widget_empty"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:textColor="@color/life_widget_text_muted"
      android:textSize="14sp" />
  </FrameLayout>
</LinearLayout>
