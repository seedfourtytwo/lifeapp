<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/life_widget_background"
  android:orientation="vertical"
  android:paddingStart="12dp"
  android:paddingTop="10dp"
  android:paddingEnd="12dp"
  android:paddingBottom="12dp">

  <LinearLayout
    android:id="@+id/widget_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <TextView
      android:id="@+id/widget_date"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:textColor="@color/life_widget_text"
      android:textSize="26sp" />

    <TextView
      android:id="@+id/widget_progress"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:fontFamily="sans-serif-medium"
      android:textColor="@color/life_widget_accent"
      android:textSize="20sp" />

    <!-- The one deliberate way into the app; from the lock screen it asks for the unlock. -->
    <ImageView
      android:id="@+id/widget_open"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_marginStart="4dp"
      android:contentDescription="@string/life_widget_open_app"
      android:scaleType="center"
      android:src="@drawable/life_widget_ic_open_muted" />
  </LinearLayout>

  <ProgressBar
    android:id="@+id/widget_progress_bar"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="8dp"
    android:layout_marginStart="6dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="8dp"
    android:importantForAccessibility="no"
    android:progressDrawable="@drawable/life_widget_progress" />

  <!-- The timer running now, pinned above the list with a live clock and its controls. -->
  <LinearLayout
    android:id="@+id/widget_now"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:minHeight="64dp"
    android:background="@drawable/life_widget_now"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:visibility="gone">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/widget_now_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/life_widget_on_button"
        android:textSize="14sp" />

      <Chronometer
        android:id="@+id/widget_now_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/life_widget_on_button"
        android:textSize="26sp" />
    </LinearLayout>

    <ImageView
      android:id="@+id/widget_now_toggle"
      style="@style/LifeWidgetIconButton"
      android:background="@drawable/life_widget_button_strong" />

    <ImageView
      android:id="@+id/widget_now_stop"
      style="@style/LifeWidgetIconButton"
      android:layout_marginStart="2dp"
      android:background="@drawable/life_widget_button_strong" />
  </LinearLayout>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <ListView
      android:id="@+id/widget_list"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:divider="@android:color/transparent"
      android:dividerHeight="6dp"
      android:scrollbars="none" />

    <TextView
      android:id="@+id/widget_empty"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:textColor="@color/life_widget_text_muted"
      android:textSize="14sp" />
  </FrameLayout>
</LinearLayout>
