<?xml version="1.0" encoding="utf-8"?>
<!--
  One fixed dress, the same in light and dark and on every Android version: the
  widget sits on a wallpaper, not on the app's page, so it wears the evening
  ground of the home screen's icon tiles rather than the app's light theme.
  Each kind of row has one colour: timers amber, tick-off habits moss, counters
  blue, todos lilac. Every colour is flat; nothing here is a gradient.
  The app takes its colours from this dress: its evening theme and its kind
  colours (src/theme/themes.ts, src/theme/palette.ts) repeat the text, ink,
  accent and kind values below, and __tests__/themeTokens.test.ts fails when
  the two files disagree.
-->
<resources>
  <!-- The panel, a little see-through, and its hairline edge. -->
  <color name="life_widget_background">#E61F1932</color>
  <color name="life_widget_edge">#24FFFFFF</color>
  <color name="life_widget_card">#2D2647</color>
  <color name="life_widget_track">#3B3358</color>
  <color name="life_widget_text">#F6F1E8</color>
  <color name="life_widget_text_muted">#B3AEC6</color>
  <!-- What is drawn on a coloured tile. -->
  <color name="life_widget_ink">#1D1630</color>
  <color name="life_widget_accent">#86C9A3</color>
  <color name="life_widget_timer">#F0B85A</color>
  <color name="life_widget_timer_tint">#2BF0B85A</color>
  <color name="life_widget_tick">#86C9A3</color>
  <color name="life_widget_counter">#9DB8D3</color>
  <color name="life_widget_counter_tint">#2B9DB8D3</color>
  <color name="life_widget_counter_rule">#559DB8D3</color>
  <color name="life_widget_todo">#C3A8D1</color>
</resources>
