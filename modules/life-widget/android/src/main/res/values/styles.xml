<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- One step of a counter's capsule: 52dp wide, 56dp tall, so a thumb can hit it without aiming. -->
  <style name="LifeWidgetButton">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">match_parent</item>
    <item name="android:minWidth">52dp</item>
    <item name="android:gravity">center</item>
    <item name="android:maxLines">1</item>
    <item name="android:paddingStart">10dp</item>
    <item name="android:paddingEnd">10dp</item>
    <item name="android:textColor">@color/life_widget_counter</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:fontFeatureSettings">tnum</item>
    <item name="android:textSize">16sp</item>
  </style>

  <!-- A timer's control: a disc holding an icon, in a 56dp square touch target. -->
  <style name="LifeWidgetIconButton">
    <item name="android:layout_width">56dp</item>
    <item name="android:layout_height">56dp</item>
    <item name="android:background">@drawable/life_widget_button_round</item>
    <item name="android:scaleType">center</item>
  </style>
</resources>
