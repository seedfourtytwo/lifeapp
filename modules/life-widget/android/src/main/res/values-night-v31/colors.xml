<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ dark: system dynamic palette. Rows are cards (neutral1_800) on the ground (neutral1_900); muted text neutral2_200 is well above 4.5:1 on both. -->
<resources>
  <color name="life_widget_background">@android:color/system_neutral1_900</color>
  <color name="life_widget_card">@android:color/system_neutral1_800</color>
  <color name="life_widget_text">@android:color/system_neutral1_50</color>
  <color name="life_widget_text_muted">@android:color/system_neutral2_200</color>
  <color name="life_widget_accent">@android:color/system_accent1_200</color>
  <color name="life_widget_on_accent">@android:color/system_accent1_800</color>
  <color name="life_widget_button">@android:color/system_accent2_700</color>
  <color name="life_widget_on_button">@android:color/system_accent2_100</color>
</resources>
