<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- Owns the running habit timer: its sound, goal alarm and notification. -->
    <service
      android:name="expo.modules.lifecore.TimerService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />

    <!-- The lock-screen and home-screen widget. Exported so the widget host can update it. -->
    <receiver
      android:name="expo.modules.lifecore.widget.LifeWidgetProvider"
      android:exported="true"
      android:label="@string/life_core_widget_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/life_core_widget_info" />
    </receiver>

    <!-- Redraws the widget and re-arms the reminder alarm after boot, a clock, zone or language change, and an update. Only protected system broadcasts. -->
    <receiver
      android:name="expo.modules.lifecore.widget.WidgetSystemReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.LOCALE_CHANGED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>

    <!-- Every widget button and the redraw alarm: this app's own PendingIntents only. -->
    <receiver
      android:name="expo.modules.lifecore.widget.WidgetActionReceiver"
      android:exported="false" />

    <!-- The habit reminder alarm: this app's own PendingIntent only. -->
    <receiver
      android:name="expo.modules.lifecore.reminders.ReminderReceiver"
      android:exported="false" />
  </application>
</manifest>
