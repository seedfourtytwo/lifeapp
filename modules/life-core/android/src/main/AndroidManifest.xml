<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

  <application>
    <!-- Owns the running habit timer: its sound, goal alarm and notification. -->
    <service
      android:name="expo.modules.lifecore.TimerService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />

    <!-- Every widget button: this app's own PendingIntents only. -->
    <receiver
      android:name="expo.modules.lifecore.widget.WidgetActionReceiver"
      android:exported="false" />
  </application>
</manifest>
