<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

  <application>
    <!-- Owns the running habit timer: its sound, goal alarm and notification. -->
    <service
      android:name="expo.modules.lifecore.TimerService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />

    <!-- The lock-screen and home-screen widget. Exported so the widget host can update it. -->
    <receiver
      android:name="expo.modules.lifecore.widget.LifeWidgetProvider"
      android:exported="true"
      android:label="@string/life_core_widget_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/life_core_widget_info" />
    </receiver>

    <!-- Every widget button: this app's own PendingIntents only. -->
    <receiver
      android:name="expo.modules.lifecore.widget.WidgetActionReceiver"
      android:exported="false" />
  </application>
</manifest>
