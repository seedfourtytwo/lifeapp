{
  "about": "The done rule, run by dayOutcome.test fixtures in Jest and by DayRulesTest in Kotlin.",
  "cases": [
    {
      "name": "check-off ticked",
      "rule": {
        "kind": "check_off"
      },
      "facts": {
        "total": 1,
        "trackCompleted": false,
        "markedComplete": false
      },
      "done": true,
      "reason": "checked"
    },
    {
      "name": "check-off not ticked",
      "rule": {
        "kind": "check_off"
      },
      "facts": {
        "total": 0,
        "trackCompleted": false,
        "markedComplete": false
      },
      "done": false,
      "reason": "not_checked"
    },
    {
      "name": "check-off marked done counts as checked once ticked",
      "rule": {
        "kind": "check_off"
      },
      "facts": {
        "total": 0,
        "trackCompleted": false,
        "markedComplete": true
      },
      "done": true,
      "reason": "marked_complete"
    },
    {
