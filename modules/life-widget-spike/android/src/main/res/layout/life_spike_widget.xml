<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="8dp"
  android:background="#E0101010">

  <TextView android:id="@+id/spike_count" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp"
    android:text="taps: 0" />
  <TextView android:id="@+id/spike_host" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="11sp"
    android:maxLines="3" android:text="host: ?" />
  <Chronometer android:id="@+id/spike_chrono" android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:textColor="#7CFC9A" android:textSize="20sp" />

  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal">
    <Button android:id="@+id/spike_btn_count" android:layout_width="0dp" android:layout_weight="1"
      android:layout_height="wrap_content" android:textSize="10sp" android:text="Count (broadcast)" />
    <Button android:id="@+id/spike_btn_open" android:layout_width="0dp" android:layout_weight="1"
      android:layout_height="wrap_content" android:textSize="10sp" android:text="Open app (activity)" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal">
    <Button android:id="@+id/spike_btn_start" android:layout_width="0dp" android:layout_weight="1"
      android:layout_height="wrap_content" android:textSize="10sp" android:text="Start" />
    <Button android:id="@+id/spike_btn_pause" android:layout_width="0dp" android:layout_weight="1"
      android:layout_height="wrap_content" android:textSize="10sp" android:text="Pause" />
    <Button android:id="@+id/spike_btn_service" android:layout_width="0dp" android:layout_weight="1"
      android:layout_height="wrap_content" android:textSize="10sp" android:text="Service test" />
  </LinearLayout>
</LinearLayout>
